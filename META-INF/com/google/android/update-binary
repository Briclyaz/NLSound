#!/sbin/sh
# AROMA-Next Installer - Universal Multi-Arch Recovery & Root-App Dispatcher
# - Custom Recovery (BOOTMODE=0): Full 60-120Hz Touch GUI (arm64 / arm32)
# - Booted Android  (BOOTMODE=1): Automatic native Volume Key Selector from the same aroma-config
# - Recovery Display Lock (EXIT 77): Automatic fallback to native Volume Key Selector
#
# Arguments: $1 = API version, $2 = OUTFD pipe fd, $3 = ZIP path

OUTFD="$2"
ZIPFILE="$3"

ui_print() {
  if [ -n "$OUTFD" ] && [ -e "/proc/self/fd/$OUTFD" ]; then
    printf 'ui_print %s\nui_print\n' "$1" > "/proc/self/fd/$OUTFD" 2>/dev/null && return 0
  fi
  echo "$1"
}

# Detect booted Android (Magisk / KernelSU / APatch app) vs Custom Recovery
case "$BOOTMODE" in
  true|1)  BOOTMODE=true ;;
  false|0) BOOTMODE=false ;;
  *)
    if (ps -A 2>/dev/null || ps 2>/dev/null) | grep -qE "zygote|surfaceflinger" \
       || [ -n "$(pidof zygote zygote64 surfaceflinger 2>/dev/null)" ]; then
      BOOTMODE=true
    else
      BOOTMODE=false
    fi
    ;;
esac
export BOOTMODE

ARCH="$(uname -m)"
TMPDIR="/tmp/aroma-next"
[ "$BOOTMODE" = "true" ] && TMPDIR="/dev/tmp/aroma-next"
rm -rf "$TMPDIR"
mkdir -p "$TMPDIR"

extract_aroma_bin() {
  local candidates c
  case "$ARCH" in
    aarch64|arm64*)
      candidates="META-INF/com/google/android/bin/aroma_installer-arm64 META-INF/com/google/android/bin/aroma_installer-arm32 META-INF/com/google/android/aroma_installer"
      ;;
    armv7*|armv8*|arm*)
      candidates="META-INF/com/google/android/bin/aroma_installer-arm32 META-INF/com/google/android/aroma_installer"
      ;;
    x86_64|amd64)
      candidates="META-INF/com/google/android/bin/aroma_installer-x86_64 META-INF/com/google/android/aroma_installer"
      ;;
    *)
      candidates="META-INF/com/google/android/aroma_installer"
      ;;
  esac
  BIN_PATH=""
  for c in $candidates; do
    unzip -o "$ZIPFILE" "$c" -d "$TMPDIR" >/dev/null 2>&1
    if [ -f "$TMPDIR/$c" ]; then
      BIN_PATH="$TMPDIR/$c"
      chmod 755 "$BIN_PATH"
      break
    fi
  done
}

run_fallback_installer() {
  unzip -o "$ZIPFILE" "META-INF/com/google/android/magisk-installer" -d "$TMPDIR" >/dev/null 2>&1
  if [ -f "$TMPDIR/META-INF/com/google/android/magisk-installer" ]; then
    chmod 755 "$TMPDIR/META-INF/com/google/android/magisk-installer"
    exec sh "$TMPDIR/META-INF/com/google/android/magisk-installer" "$1" "$2" "$3"
  fi
  unzip -o "$ZIPFILE" "META-INF/com/google/android/update-binary-installer" -d "$TMPDIR" >/dev/null 2>&1
  if [ -f "$TMPDIR/META-INF/com/google/android/update-binary-installer" ]; then
    chmod 755 "$TMPDIR/META-INF/com/google/android/update-binary-installer"
    "$TMPDIR/META-INF/com/google/android/update-binary-installer" "$1" "$2" "$3"
    FB_RC=$?
    if [ "$FB_RC" -ne 0 ]; then
      ui_print "! Legacy update-binary-installer exited with status $FB_RC."
    fi
    exit "$FB_RC"
  fi
  if [ -f /data/adb/magisk/util_functions.sh ]; then
    export OUTFD ZIPFILE BOOTMODE
    . /data/adb/magisk/util_functions.sh
    install_module
    exit $?
  fi
  ui_print "! No fallback installer found in archive."
  exit 1
}

# Booted Android (BOOTMODE=1): Hand off to magisk-installer -> customize.sh
# (customize.sh invokes aroma_run_config_if_needed -> native AROMA Volume Key Selector!)
if [ "$BOOTMODE" = "true" ]; then
  ui_print "- AROMA-Next: Booted Android detected (BOOTMODE=1)"
  ui_print "- Switching aroma-config to native Volume Key Selector mode..."
  run_fallback_installer "$1" "$2" "$3"
fi

# Custom Recovery (BOOTMODE=0): Launch full Touch GUI
extract_aroma_bin

if [ -z "$BIN_PATH" ] || [ ! -x "$BIN_PATH" ]; then
  ui_print "! No compatible AROMA-Next binary for arch: $ARCH"
  run_fallback_installer "$1" "$2" "$3"
fi

"$BIN_PATH" "$1" "$2" "$3"
RC=$?

if [ "$RC" -eq 77 ]; then
  ui_print "! AROMA-Next: Display locked by recovery (DRM master / no fbdev)."
  ui_print "- Switching to native AROMA-Next Volume Key Selector..."
  "$BIN_PATH" --volkey "$1" "$2" "$3"
  exit $?
fi

exit "$RC"
