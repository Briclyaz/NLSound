#!/sbin/sh
# NLSound — AROMA-Next-Installer Dual-Mode Dispatcher
# - Custom Recovery (BOOTMODE=false / 0): Launches AROMA-Next Touch GUI (arm64 / arm32)
# - Android System  (BOOTMODE=true  / 1): Hands off to NLSound Volume Key Selector
# - Recovery Display Lock (EXIT 77):      Falls back cleanly to non-GUI defaults
#
# Powered by AROMA-Next-Installer (https://github.com/Miustone/AROMA-Next-Installer)

OUTFD="$2"
ZIPFILE="$3"

ui_print() {
  if [ -n "$OUTFD" ] && [ -e "/proc/self/fd/$OUTFD" ]; then
    printf 'ui_print %s\nui_print\n' "$1" > "/proc/self/fd/$OUTFD" 2>/dev/null && return 0
  fi
  echo "$1"
}

# Normalize / detect BOOTMODE (Android system vs Custom Recovery)
case "$BOOTMODE" in
  true|1)
    BOOTMODE=true
    ;;
  false|0)
    BOOTMODE=false
    ;;
  *)
    if (ps -A 2>/dev/null || ps 2>/dev/null) | grep -qE "zygote|surfaceflinger" \
       || [ -n "$(pidof zygote zygote64 surfaceflinger 2>/dev/null)" ]; then
      BOOTMODE=true
    else
      BOOTMODE=false
    fi
    ;;
esac
export BOOTMODE

ARCH="$(uname -m)"
TMPDIR="/tmp/aroma-next"
[ "$BOOTMODE" = "true" ] && TMPDIR="/dev/tmp/aroma-next"
rm -rf "$TMPDIR"
mkdir -p "$TMPDIR"

run_module_installer() {
  unzip -o "$ZIPFILE" "META-INF/com/google/android/magisk-installer" -d "$TMPDIR" >/dev/null 2>&1
  if [ -f "$TMPDIR/META-INF/com/google/android/magisk-installer" ]; then
    chmod 755 "$TMPDIR/META-INF/com/google/android/magisk-installer"
    exec sh "$TMPDIR/META-INF/com/google/android/magisk-installer" "$1" "$2" "$3"
  fi
  if [ -f /data/adb/magisk/util_functions.sh ]; then
    export OUTFD ZIPFILE BOOTMODE
    . /data/adb/magisk/util_functions.sh
    install_module
    exit $?
  fi
  ui_print "! No module installer bridge found in archive."
  exit 1
}

# Booted Android (Magisk / KernelSU / APatch Manager -> BOOTMODE=true/1)
if [ "$BOOTMODE" = "true" ]; then
  ui_print "- Booted Android detected (BOOTMODE=1)"
  ui_print "- Launching NLSound Volume Key Selector..."
  ui_print "  (Tip: Flash in Recovery for the full AROMA-Next Touch GUI!)"
  run_module_installer "$1" "$2" "$3"
fi

# Custom Recovery (TWRP / OrangeFox / AERA / PitchBlack -> BOOTMODE=false/0)
# Clear any stale AROMA state from a previous flash in this recovery session
rm -rf /tmp/aroma

CANDIDATES=""
case "$ARCH" in
  aarch64|arm64*)
    CANDIDATES="META-INF/com/google/android/bin/aroma_installer-arm64 META-INF/com/google/android/bin/aroma_installer-arm32"
    ;;
  armv7*|armv8*|arm*)
    CANDIDATES="META-INF/com/google/android/bin/aroma_installer-arm32"
    ;;
  *)
    CANDIDATES="META-INF/com/google/android/bin/aroma_installer-arm64 META-INF/com/google/android/bin/aroma_installer-arm32"
    ;;
esac

BIN_PATH=""
for c in $CANDIDATES; do
  unzip -o "$ZIPFILE" "$c" -d "$TMPDIR" >/dev/null 2>&1
  if [ -f "$TMPDIR/$c" ]; then
    BIN_PATH="$TMPDIR/$c"
    chmod 755 "$BIN_PATH"
    break
  fi
done

if [ -z "$BIN_PATH" ] || [ ! -x "$BIN_PATH" ]; then
  ui_print "! No compatible AROMA-Next binary for arch: $ARCH"
  export AROMA_FALLBACK=1
  run_module_installer "$1" "$2" "$3"
fi

"$BIN_PATH" "$1" "$2" "$3"
RC=$?

if [ "$RC" -eq 77 ]; then
  ui_print "! AROMA-Next: Display locked by recovery (DRM master / no fbdev)."
  ui_print "- Falling back to headless NLSound installation (no Volume Key prompt)..."
  export AROMA_FALLBACK=1
  run_module_installer "$1" "$2" "$3"
fi

exit "$RC"
